rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    function isAdmin() { return signedIn() && email() in ['zipphive@gmail.com']; }
    function isManager() {
      return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/managers/$(email())));
    }
    function isTech() {
      return signedIn()
        && exists(/databases/$(database)/documents/technicians/$(email()))
        && get(/databases/$(database)/documents/technicians/$(email())).data.active == true;
    }
    function okStr(v, n) { return v is string && v.size() <= n; }

    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /prices/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Store managers: added/removed by the admin from manager.html
    match /managers/{mgrEmail} {
      allow read: if isManager();
      allow write: if isAdmin();
    }

    match /technicians/{techEmail} {
      allow read: if isManager() || (signedIn() && techEmail == email());
      allow write: if isAdmin();
    }

    // Time-slot usage, one doc per day: { n: { "phone_0900": 2, "cleaning_1000": 1 } }.
    // Customers may only add 1 to a single slot, and never above the capacity set on /slots.html (content/slots).
    function slotCap(day, k) {
      let c = get(/databases/$(database)/documents/content/slots).data;
      let parts = k.split('_');
      let d = c.get('dates', {}).get(day, {});
      return d.get('closed', false) ? 0 : d.get('cap', c.get('cap', {})).get(parts[1], {}).get(parts[0], 0);
    }
    function addOne(day, k, before) {
      return request.resource.data.n[k] == before + 1 && request.resource.data.n[k] <= slotCap(day, k);
    }
    // Anonymous website funnel counters (zh-stats.js): stats/{yyyy-mm-dd} = { n: { visit: 12, step_slot: 4 } }.
    // Visitors may only add 1 to a single counter; only admin / store managers can read.
    function okStatKey(k) { return k.matches('^[a-z0-9_]{2,40}$'); }
    match /stats/{day} {
      allow read: if isManager();
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n.keys().size() == 1
        && okStatKey(request.resource.data.n.keys()[0])
        && request.resource.data.n[request.resource.data.n.keys()[0]] == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n'])
        && request.resource.data.n.size() <= 600
        && request.resource.data.n.diff(resource.data.n).affectedKeys().size() == 1
        && okStatKey(request.resource.data.n.diff(resource.data.n).affectedKeys().toList()[0])
        && request.resource.data.n[request.resource.data.n.diff(resource.data.n).affectedKeys().toList()[0]]
           == resource.data.n.get(request.resource.data.n.diff(resource.data.n).affectedKeys().toList()[0], 0) + 1;
    }

    match /slotUse/{day} {
      allow read: if true;
      allow write: if isManager();
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n.keys().size() == 1
        && addOne(day, request.resource.data.n.keys()[0], 0);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n'])
        && request.resource.data.n.diff(resource.data.n).affectedKeys().size() == 1
        && addOne(day, request.resource.data.n.diff(resource.data.n).affectedKeys().toList()[0],
                  resource.data.n.get(request.resource.data.n.diff(resource.data.n).affectedKeys().toList()[0], 0));
    }

    match /bookings/{bookingId} {
      allow get: if true;
      allow list: if isManager() || (isTech() && resource.data.techEmail == email());

      // New bookings from the website. kind "warranty" = a warranty claim from /warranty.html:
      // a free job (price 0) carrying the claim details and an optional small photo.
      allow create: if bookingId.size() >= 16
        && request.resource.data.keys().hasOnly(['code', 'createdAt', 'statusAt', 'status', 'kind', 'service', 'device', 'problem', 'item', 'price', 'name', 'mobile', 'area', 'time', 'note', 'warranty', 'slot'])
        && request.resource.data['status'] == 'new'
        && request.resource.data['kind'] in ['phone', 'service', 'warranty']
        && okStr(request.resource.data['code'], 12)
        && request.resource.data['createdAt'] is int
        && okStr(request.resource.data['service'], 80)
        && okStr(request.resource.data['name'], 60)
        && request.resource.data['mobile'] is string && request.resource.data['mobile'].matches('^[6-9][0-9]{9}$')
        && okStr(request.resource.data['area'], 60)
        && okStr(request.resource.data['time'], 40)
        && (!('device' in request.resource.data) || okStr(request.resource.data['device'], 80))
        && (!('problem' in request.resource.data) || okStr(request.resource.data['problem'], 200))
        && (!('item' in request.resource.data) || okStr(request.resource.data['item'], 120))
        && (!('note' in request.resource.data) || okStr(request.resource.data['note'], 300))
        && (!('slot' in request.resource.data) || okStr(request.resource.data['slot'], 40))
        && (!('price' in request.resource.data) || request.resource.data['price'] == null || request.resource.data['price'] is number)
        && (request.resource.data['kind'] != 'warranty' || (request.resource.data['price'] == 0 && 'warranty' in request.resource.data))
        && (!('warranty' in request.resource.data) || (
              request.resource.data['kind'] == 'warranty'
              && request.resource.data['warranty'] is map
              && request.resource.data['warranty'].keys().hasOnly(['claimId', 'origBookingId', 'origCode', 'invoiceNo', 'repairDate', 'technician', 'since', 'photo'])
              && okStr(request.resource.data['warranty'].get('claimId', ''), 12)
              && okStr(request.resource.data['warranty'].get('photo', ''), 400000)));

      // Admin and store managers can edit any booking (assign, confirm, ETA, cancel)
      allow update: if isManager();

      // Technician: accept / decline, move the job forward, share location, quality checks, payment, remarks
      allow update: if isTech()
        && resource.data.techEmail == email()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'status', 'statusAt', 'techLoc',
             'assignState', 'acceptedAt', 'techName', 'techPhone', 'techPhoto',
             'techEmail', 'offerName', 'declinedByName', 'declineReason', 'declinedAt',
             'preQc', 'postQc', 'payment', 'times', 'techRemarks'
           ])
        && (!('techRemarks' in request.resource.data) || okStr(request.resource.data['techRemarks'], 2000))
        && (!('status' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data['status'] in ['assigned', 'on_the_way', 'arrived', 'in_progress', 'completed'])
        && (request.resource.data['techEmail'] == email()
            || (request.resource.data['techEmail'] == '' && request.resource.data['assignState'] == 'declined'));

      allow delete: if isAdmin();
    }
  }
}
