rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    function isAdmin() { return signedIn() && email() in ['zipphive@gmail.com']; }
    function isManager() {
      return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/managers/$(email())));
    }
    function isTech() {
      return signedIn()
        && exists(/databases/$(database)/documents/technicians/$(email()))
        && get(/databases/$(database)/documents/technicians/$(email())).data.active == true;
    }
    function okStr(v, n) { return v is string && v.size() <= n; }

    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /prices/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Store managers: added/removed by the admin from manager.html
    match /managers/{mgrEmail} {
      allow read: if isManager();
      allow write: if isAdmin();
    }

    match /technicians/{techEmail} {
      allow read: if isManager() || (signedIn() && techEmail == email());
      allow write: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow get: if true;
      allow list: if isManager() || (isTech() && resource.data.techEmail == email());

      allow create: if bookingId.size() >= 16
        && request.resource.data.keys().hasOnly(['code', 'createdAt', 'statusAt', 'status', 'kind', 'service', 'device', 'problem', 'item', 'price', 'name', 'mobile', 'area', 'time', 'note'])
        && request.resource.data['status'] == 'new'
        && request.resource.data['kind'] in ['phone', 'service']
        && okStr(request.resource.data['code'], 12)
        && request.resource.data['createdAt'] is int
        && okStr(request.resource.data['service'], 80)
        && okStr(request.resource.data['name'], 60)
        && request.resource.data['mobile'] is string && request.resource.data['mobile'].matches('^[6-9][0-9]{9}$')
        && okStr(request.resource.data['area'], 60)
        && okStr(request.resource.data['time'], 40)
        && (!('device' in request.resource.data) || okStr(request.resource.data['device'], 80))
        && (!('problem' in request.resource.data) || okStr(request.resource.data['problem'], 200))
        && (!('item' in request.resource.data) || okStr(request.resource.data['item'], 120))
        && (!('note' in request.resource.data) || okStr(request.resource.data['note'], 300))
        && (!('price' in request.resource.data) || request.resource.data['price'] == null || request.resource.data['price'] is number);

      // Admin and store managers can edit any booking (assign, confirm, ETA, cancel)
      allow update: if isManager();

      // Technician: accept / decline, move the job forward, share location, quality checks, payment, remarks
      allow update: if isTech()
        && resource.data.techEmail == email()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'status', 'statusAt', 'techLoc',
             'assignState', 'acceptedAt', 'techName', 'techPhone', 'techPhoto',
             'techEmail', 'offerName', 'declinedByName', 'declineReason', 'declinedAt',
             'preQc', 'postQc', 'payment', 'times', 'techRemarks'
           ])
        && (!('techRemarks' in request.resource.data) || okStr(request.resource.data['techRemarks'], 2000))
        && (!('status' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data['status'] in ['assigned', 'on_the_way', 'arrived', 'in_progress', 'completed'])
        && (request.resource.data['techEmail'] == email()
            || (request.resource.data['techEmail'] == '' && request.resource.data['assignState'] == 'declined'));

      allow delete: if isAdmin();
    }
  }
}
